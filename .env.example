NEXT_PUBLIC_SUPABASE_URL=https://glnihgjgzygdfnleicqb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
# Runtime aliases recommended for Docker/Dockploy. They avoid embedding the
# public Storage configuration during image build.
SOLUREPORT_SUPABASE_URL=https://glnihgjgzygdfnleicqb.supabase.co
SOLUREPORT_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# PostgreSQL V2 via Supabase (use the Transaction Pooler URL from Supabase in production).
# The pooler URL normally uses port 6543; do not use the direct db.*:5432 URL on Vercel.
SOLUREPORT_DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR-PASSWORD@YOUR-POOLER-HOST:6543/postgres
# For one long-lived Dockploy container, 4 is a safe starting point. Keep 2 on Vercel.
SOLUREPORT_DB_POOL_MAX=4
SOLUREPORT_DATABASE_SSL=true
SOLUREPORT_COOKIE_SECURE=true
RESEND_API_KEY=
RESEND_FROM_EMAIL=notificaciones@example.com
RESEND_REPLY_TO=
